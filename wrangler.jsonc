{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 必须与 Cloudflare 控制台中的 Worker 名称一致，否则 Workers Builds 会构建失败
  "name": "virtual-home",
  "compatibility_date": "2026-11-01",
  // wrangler deploy、preview、dev 前都会先执行构建，控制台无需另配构建命令
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // 不用 SPA 回退：缺失的资源应返回 404，避免 Service Worker 把 index.html 缓存成 JS/CSS
    "not_found_handling": "none"
  },
  // 自定义域名 house.yueming.uk 在控制台绑定，不写 routes：部署时不改 DNS，
  // 也就不依赖 DNS 编辑权限（Workers Builds 自动创建的令牌没有）。
  // 保留 *.workers.dev 地址与预览链接，便于排查
  "workers_dev": true,
  "preview_urls": true,
  // Workers Builds 对非生产分支运行 `wrangler preview`，必须有此块（可为空），否则构建会失败；预览不影响线上
  "previews": {}
}
